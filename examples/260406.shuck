# Example/reference control file for the 2026-04-06 TOI-3884 reduction.
# Draft format: intended to exercise parser/setup design before numerical implementation.

[shuck]
format_version = 1
raw_path = raw
cal_path = cal
proc_path = proc
qa_path = qa

[extraction]
reduction_mode = A-Sky/Dark
n_apertures = 1
optimal = true
psf_radius = 1.0
aperture_radius = 1.0
background_start = 1.1
background_width = 2.0
background_degree = 0
trace_degree = 2

[combine]
statistic = robust_weighted_mean
sigma_clip = 8.0
J3_scale_order = 402
Kgas_scale_order = 224
shift_spectra = false
prune = false
shape_correction = false

[telluric]
method = IP
find_shifts = false

calibrations read
calib_id | mode | flat_files | arc_on | arc_off
C01 | J3 | icm.2026A021.260406.flat.00001.a.fits,icm.2026A021.260406.flat.00002.a.fits,icm.2026A021.260406.flat.00003.a.fits,icm.2026A021.260406.flat.00004.a.fits,icm.2026A021.260406.flat.00005.a.fits | icm.2026A021.260406.arc.00006.a.fits | icm.2026A021.260406.arc.00007.b.fits
C02 | Kgas | icm.2026A021.260406.flat.00033.a.fits,icm.2026A021.260406.flat.00034.a.fits,icm.2026A021.260406.flat.00035.a.fits,icm.2026A021.260406.flat.00036.a.fits,icm.2026A021.260406.flat.00037.a.fits | icm.2026A021.260406.arc.00038.a.fits | icm.2026A021.260406.arc.00039.b.fits
calibrations end

# The setup command should generate dark rows from the raw directory. Only IDs used below are shown.
darks read
dark_id | itime | ndr | coadds | files
D9 | 9.7304 | 21 | 1 | <auto-generated dark file list>
D99 | 99.6204 | 32 | 1 | <auto-generated dark file list>
D199 | 199.7041 | 32 | 1 | <auto-generated dark file list>
D299 | 299.7879 | 32 | 1 | <auto-generated dark file list>
darks end

standards read
standard_id | target | bmag | vmag | rv_kms
HD106965 | HD_106965 | 7.63 | 7.54 | <enter verified SIMBAD RV used for reduction>
standards end

data read
filename | frametype | target | mode | beam | calib | dark | comb_id | telluric_group
icm.2026A021.260406.TOI3884.00020.a.fits | science | TOI3884 | J3 | A | C01 | D299 | TOI3884_J3 | HD106965_J3
icm.2026A021.260406.TOI3884.00021.b.fits | ignore | TOI3884 | J3 | B | | | |
icm.2026A021.260406.TOI3884.00022.b.fits | ignore | TOI3884 | J3 | B | | | |
